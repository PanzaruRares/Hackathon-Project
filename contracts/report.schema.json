{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SightLine report",
  "type": "object",
  "required": ["locations", "ranking", "creative_suggestions", "summary"],
  "properties": {
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location_id", "visibility_score", "readability_score", "attention_score", "cost_per_real_impression_eur", "verdict"],
        "properties": {
          "location_id": { "type": "string" },
          "visibility_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "readability_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "attention_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "cost_per_real_impression_eur": { "type": "number" },
          "verdict": { "type": "string", "description": "o propozitie pentru marketer" }
        }
      }
    },
    "ranking": { "type": "array", "items": { "type": "string" }, "description": "location_id de la cea mai buna la cea mai slaba valoare" },
    "creative_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "suggestion"],
        "properties": {
          "issue": { "type": "string" },
          "suggestion": { "type": "string" },
          "shortened_text": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string", "description": "2-3 propozitii, cu cifrele din date, fara cifre inventate" }
  }
}
